# Dependencias instaladas localmente
/vendor/
/node_modules/

# Configuración local y credenciales
/.env
/.env.backup
/.env.production
/auth.json

# Archivos generados por Laravel, Vite y pruebas
/app.zip
/.phpunit.result.cache
/bootstrap/cache/*.php
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/api-docs/*
!/storage/api-docs/.gitignore
/storage/framework/lsp-*.php

# Registros de depuración de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Configuración local de herramientas e IDE
/.agents/
/.fleet/
/.idea/
/.vscode/
/.phpactor.json
/.phpunit.cache/

# Archivos propios del sistema operativo
.DS_Store
Thumbs.db

# Skills de uso solo local (no subir al repo, solo solo-espanol queda versionado)
/.opencode/skills/find-skills/
/.opencode/skills/frontend-design/
/.opencode/skills/vue-best-practices/
/.opencode/skills/impeccable/
/.opencode/skills/grill-me/
/.opencode/skills/grilling/
/skills-lock.json

# Respaldos locales de base de datos (nunca versionar)
/backups/

# Residuos de depuración manual (respuestas de curl, scripts de prueba)
# Un archivo oculto .algo.json en la raíz es salida de una llamada a la API.
/.*.json
/.scratch/
/.scr*.txt
