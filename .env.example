APP_NAME="NoaTrasporteApi"
APP_ENV=local
APP_KEY=base64:Nrej7RUP/sBm9xPQ3MFTqPJCTNW3iP45cGZrZHDEu18=
APP_DEBUG=true
APP_URL=https://api.transportessinbarreras.com
FRONTEND_URL=https://apptransportessinbarreras.transportessinbarreras.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soluci15_nexttransporte-db
DB_USERNAME=root
DB_PASSWORD=

# ─── CACHE & SESSION & QUEUE (Consistente y sin duplicados) ───
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL (para notificaciones de facturas) ──────
MAIL_MAILER=smtp
MAIL_HOST=mail.solucionesintegralesmana.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@solucionesintegralesmana.com
MAIL_PASSWORD="Notificaciones2026"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=notificaciones@solucionesintegralesmana.com
MAIL_FROM_NAME="NOA Transportes"

# ─── STORAGE (archivos protegidos: SOAT, RTM, PDF) ─
# Nota: FILESYSTEM_DISK=local apunta a storage/app/private según config/filesystems.php
PRIVATE_DISK_ROOT=storage/app/private

# ─── SANCTUM (autenticación API con tokens) ──────
SANCTUM_STATEFUL_DOMAINS="localhost:5173,localhost,127.0.0.1,transportessinbarreras.local,api.transportessinbarreras.com,noa.solucionesintegralesmana.com,apptransportessinbarreras.transportessinbarreras.com"

# ─── CORS (alineado con config/cors.php usando FRONTEND_URLS) ─
FRONTEND_URLS="http://localhost:5173,https://apptransportessinbarreras.transportessinbarreras.com,https://noa.solucionesintegralesmana.com,https://api.transportessinbarreras.com"
CORS_ALLOWED_ORIGINS="http://localhost:5173,https://apptransportessinbarreras.transportessinbarreras.com,https://noa.solucionesintegralesmana.com,https://api.transportessinbarreras.com"
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Company-UUID,X-Request-ID
CORS_EXPOSE_HEADERS=Content-Length,X-Request-ID
CORS_MAX_AGE=86400

# ─── SWAGGER / OPENAPI ───────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://api.transportessinbarreras.com
L5_SWAGGER_CONST_PATH=
L5_SWAGGER_DOC_ENDPOINT=api/documentation

# ─── RATE LIMITING (alineado con config/api.php usando API_RATE_LIMIT) ───
API_RATE_LIMIT=60
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_TENANT=1000

# ─── DIAN INTEGRATION (facturación electrónica) ─
DIAN_ENV=production
DIAN_API_URL=https://facturaelectronica.dian.gov.co
DIAN_CLIENT_ID=tu_client_id
DIAN_CLIENT_SECRET=tu_client_secret

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── GOOGLE OAUTH & DRIVE ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://apptransportessinbarreras.transportessinbarreras.com/auth/google/callback"
